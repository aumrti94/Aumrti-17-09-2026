    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "supabase": "^2.108.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
