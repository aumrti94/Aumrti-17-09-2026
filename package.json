{
  "name": "aumrti-hms",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-tenant Hospital Management System for Indian hospitals.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:inventory": "node scripts/generate-test-inventory.mjs --check",
    "check:fixture-phi": "node scripts/check-fixture-phi.mjs",
    "e2e:seed": "node e2e/fixtures/seed-cli.ts",
    "inventory": "node scripts/generate-test-inventory.mjs",
    "check:rls-coverage": "node scripts/check-rls-coverage.mjs",
    "check:user-fk": "node scripts/check-user-fk-convention.mjs",
    "check:db-contract": "node scripts/check-db-contract.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "check:lab-catalog": "node scripts/generate-lab-catalog.mjs --check",
    "check:no-phi-logs": "node scripts/check-no-phi-logs.mjs",
    "lab:catalog": "node scripts/generate-lab-catalog.mjs",
    "api:openapi": "node scripts/generate-openapi.mjs",
    "supabase:push": "dotenv --override -e .env.local -- npx supabase db push",
    "supabase:deploy": "dotenv --override -e .env.local -- npx supabase functions deploy",
    "supabase:link": "dotenv --override -e .env.local -- npx supabase link"
  },
