VITE_SUPABASE_URL=https://pdxvisvmnzjhsgmvygku.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBkeHZpc3ZtbnpqaHNnbXZ5Z2t1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIwNTM5MTQsImV4cCI6MjA5NzYyOTkxNH0.vzjLIfw5nLZwX4SpOH23dHWYiKLR1EkedL6tKAwzRws

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN / CLI SECRETS (NON-VITE — never bundled)   ·   ACTIVE PROJECT: AumrtiHOS
#   Used by the Supabase CLI (db push / functions deploy) and server-side only.
