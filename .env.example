# Copy this file to .env.local and fill in real values from Supabase Dashboard → Settings → API
# Real credentials live in .env.local (gitignored — NEVER commit that file)

# ── Active project ─────────────────────────────────────────────────────────────
# Find your project ref and keys at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── CLI / server-side (NOT prefixed VITE_ — never bundled into browser JS) ────
SUPABASE_PROJECT_REF=<your-project-ref>
SUPABASE_DB_PASSWORD=<your-db-password>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Personal access token — loaded by npm run supabase:push / supabase:deploy (via dotenv-cli).
# Overrides `supabase login` stored token. Must belong to the account that OWNS the project's org.
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=<your-personal-access-token>

# ── AI Providers ─────────────────────────────────────────────────────────────
# WARNING: AI keys must be set as Supabase Edge Function secrets, NOT as VITE_ vars.
# Set them server-side: supabase secrets set OPENAI_API_KEY=sk-...
# These VITE_ vars are intentionally blank — the ai-proxy edge function reads
# keys from Deno.env, not from the browser bundle.
VITE_ANTHROPIC_KEY=
VITE_OPENAI_KEY=

# Azure OpenAI (India Central — DPDP Act data residency)
VITE_AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o
VITE_AZURE_OPENAI_API_KEY=
VITE_AZURE_OPENAI_API_VERSION=2024-02-01

VITE_GEMINI_KEY=
VITE_PERPLEXITY_KEY=
VITE_SARVAM_KEY=
VITE_BHASHINI_KEY=

# ── Mobile App (Expo) ────────────────────────────────────────────────────────
# These are PUBLIC keys for the React Native app (exposed in the bundle — anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── WhatsApp Bot (Phase 5C) ───────────────────────────────────────────────────
# Set as Supabase Edge Function secret: supabase secrets set META_WEBHOOK_VERIFY_TOKEN=<random-string>
# Must match the verify_token you set in Meta Business Manager → WhatsApp → Webhooks
META_WEBHOOK_VERIFY_TOKEN=

# ── Signup OTP (platform-level — used by /register, NOT per-hospital) ──────────
# These are Supabase EDGE FUNCTION SECRETS (set with `supabase secrets set …`), never VITE_ vars.
# The send-signup-otp function tries providers in this order; the first fully-configured one wins.
#
# 1) WhatsApp via Meta Cloud API (preferred — real WhatsApp delivery).
#    Requires a platform WhatsApp Business number + a Meta-APPROVED "authentication" template
#    whose body + copy-code button each take the {{1}} code parameter.
#      supabase secrets set PLATFORM_META_PHONE_NUMBER_ID=<waba-phone-number-id>
#      supabase secrets set PLATFORM_META_ACCESS_TOKEN=<permanent-access-token>
#      supabase secrets set PLATFORM_META_OTP_TEMPLATE=<approved_auth_template_name>
#      supabase secrets set PLATFORM_META_OTP_TEMPLATE_LANG=en   # optional, default "en"
#
# 2) SMS via MSG91 (fallback). Pass our own OTP through an MSG91 OTP template.
#      supabase secrets set MSG91_API_KEY=<authkey>
#      supabase secrets set MSG91_OTP_TEMPLATE_ID=<otp-template-id>
#
# 3) SMS via Twilio (fallback): TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER
#
# Local dev ONLY — when no provider above is configured, return the code in the API
# response (the wizard shows it under the inputs). NEVER set this in production.
#      supabase secrets set ALLOW_OTP_DEV_FALLBACK=true

# ── Error monitoring ──────────────────────────────────────────────────────────
# Leave blank in development to skip Sentry initialization
VITE_SENTRY_DSN=
