SUPABASE_PROJECT_REF=pdxvisvmnzjhsgmvygku
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token — overrides `supabase login` stored token.
# Must belong to the account that OWNS org ggsxhowdkpbppbqcxero.
# Generate at: https://supabase.com/dashboard/account/tokens
# Used by: npm run supabase:push / supabase:deploy (loaded via dotenv-cli)
SUPABASE_ACCESS_TOKEN=sbp_461a5ab0387bd779a96f96397f12c1b029c9c7b1


# ── AI Providers ─────────────────────────────────────────────────────────────
# WARNING: AI keys must be set as Supabase Edge Function secrets, NOT as VITE_ vars.
# Set them server-side: supabase secrets set OPENAI_API_KEY=sk-...
# These VITE_ vars are intentionally blank — the ai-proxy edge function reads
# keys from Deno.env, not from the browser bundle.
VITE_ANTHROPIC_KEY=
VITE_OPENAI_KEY=

# Azure OpenAI (India Central — DPDP Act data residency)
# REMOVED as of the 2026-08 security audit: aiProvider.ts no longer calls Azure directly
# from the browser (that shipped VITE_AZURE_OPENAI_API_KEY to every client). Azure now
# routes through the ai-proxy edge function like every other provider — confirmed safe for
# DPDP data residency since Edge Functions run in ap-south-1 (Mumbai). Configure the Azure
# key via `supabase secrets set AZURE_OPENAI_API_KEY=...` or the platform_ai_keys admin UI
# instead. If VITE_AZURE_OPENAI_API_KEY was ever set in a production build environment,
# treat that key as burned (it was in the shipped JS bundle) — rotate it in Azure.

VITE_GEMINI_KEY=
VITE_PERPLEXITY_KEY=
VITE_SARVAM_KEY=
VITE_BHASHINI_KEY=

# ── Mobile App (Expo) ────────────────────────────────────────────────────────
# These are PUBLIC keys for the React Native app (exposed in the bundle — anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── WhatsApp Bot (Phase 5C) ───────────────────────────────────────────────────
# Set as Supabase Edge Function secret: supabase secrets set META_WEBHOOK_VERIFY_TOKEN=<random-string>
# Must match the verify_token you set in Meta Business Manager → WhatsApp → Webhooks
META_WEBHOOK_VERIFY_TOKEN=
# REQUIRED — the whatsapp-bot function now rejects every inbound message without this.
# Set as Supabase Edge Function secret: supabase secrets set META_APP_SECRET=<app-secret>
# From Meta App Dashboard → Settings → Basic → App Secret. Used to verify the
# X-Hub-Signature-256 header on every inbound webhook POST, so forged "incoming message"
# payloads can't be posted by anyone who finds the function URL.
META_APP_SECRET=

# ── Signup OTP (platform-level — used by /register, NOT per-hospital) ──────────
# These are Supabase EDGE FUNCTION SECRETS (set with `supabase secrets set …`), never VITE_ vars.
# The send-signup-otp function tries providers in this order; the first fully-configured one wins.
#
# 1) WhatsApp via Meta Cloud API (preferred — real WhatsApp delivery).
#    Requires a platform WhatsApp Business number + a Meta-APPROVED "authentication" template
#    whose body + copy-code button each take the {{1}} code parameter.
#      supabase secrets set PLATFORM_META_PHONE_NUMBER_ID=<waba-phone-number-id>
#      supabase secrets set PLATFORM_META_ACCESS_TOKEN=<permanent-access-token>
#      supabase secrets set PLATFORM_META_OTP_TEMPLATE=<approved_auth_template_name>
#      supabase secrets set PLATFORM_META_OTP_TEMPLATE_LANG=en   # optional, default "en"
#
# 2) SMS via MSG91 (fallback). Pass our own OTP through an MSG91 OTP template.
#      supabase secrets set MSG91_API_KEY=<authkey>
#      supabase secrets set MSG91_OTP_TEMPLATE_ID=<otp-template-id>
#
# 3) SMS via Twilio (fallback): TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER
#
# Local dev ONLY — when no provider above is configured, return the code in the API
# response (the wizard shows it under the inputs). NEVER set this in production.
#      supabase secrets set ALLOW_OTP_DEV_FALLBACK=true

# ── Brand domain ──────────────────────────────────────────────────────────────
# The product domain, used for support/sales addresses, invoice footers, the
# white-label CNAME target, the public API base and the docs link.
# Defaults to aumrti.com in src/lib/brand.ts — set this only to override
# (e.g. a staging domain). Edge functions read the same value from a secret:
#      supabase secrets set APP_DOMAIN=aumrti.com
VITE_APP_DOMAIN=

# ── Public API gateway ────────────────────────────────────────────────────────
# Set once the api-gateway edge function is deployed AND api.<domain> is
# pointed at it. Until then the API Portal states plainly that the gateway is
# not serving, rather than showing integrators a URL that answers nothing.
VITE_API_GATEWAY_LIVE=false
# Optional explicit override; otherwise derived from VITE_SUPABASE_URL.
VITE_API_GATEWAY_URL=

# ── Error monitoring ──────────────────────────────────────────────────────────
# Leave blank in development to skip Sentry initialization
VITE_SENTRY_DSN=

# ══════════════════════════════════════════════════════════════════════════════
# QA TEST HARNESS  (put these in .env.test — which is gitignored — not here)
# ══════════════════════════════════════════════════════════════════════════════
# Used by:
#   scripts/qa-seed.mjs              seeds the two QA hospitals
#   e2e/                             the Playwright suite
#   npm run test:security            the RLS isolation vitest suite
#
# See docs/qa/README.md and docs/qa/MOCK_DATA_BOOK.md.

# The Supabase project the QA tenants live in. May be the same project you use
# for development — the two QA hospitals are isolated from real data by RLS.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=

# Service role key. Bypasses RLS, so it is used ONLY by the seeder and by test
# assertions that verify a row was really written. NEVER expose this to the app.
SUPABASE_SERVICE_ROLE_KEY=

# ── SAFETY GATES ──────────────────────────────────────────────────────────────
# The project ref you have DESIGNATED for QA, e.g. "abcdefghijklmnop" from
# https://abcdefghijklmnop.supabase.co
# Without this, e2e/global-setup.ts cannot tell a QA project from production and
# will disable all database access rather than guess.
QA_ALLOW_PROJECT_REF=

# Explicit opt-in before any test is allowed to WRITE. Leave unset until you are
# certain the target above is correct. Set to exactly "true" to enable.
QA_SEEDING_CONFIRMED=

# ── Playwright ────────────────────────────────────────────────────────────────
# The running app. Defaults to http://localhost:8080.
PLAYWRIGHT_BASE_URL=
# Set to 1 when you are already running `npm run dev` yourself and do not want
# Playwright to start its own server.
PLAYWRIGHT_NO_SERVER=

# ── Legacy names still read by src/tests/security/ ────────────────────────────
TEST_HOSPITAL_A_EMAIL=
TEST_HOSPITAL_A_PASSWORD=
TEST_HOSPITAL_B_EMAIL=
TEST_HOSPITAL_B_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
