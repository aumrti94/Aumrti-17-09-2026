# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Test/coverage output — regenerated by `npm run test:coverage` and
# `npm run test:e2e` on every run, so tracking them churns the diff.
coverage/
playwright-report/
test-results/
# Raw Playwright results the tracker reads. The workbook it produces
# (docs/qa/tracker/AUMRTI_QA_TRACKER.xlsx) is the tracked artifact of record.
docs/qa/results/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.env.local
.env.test
.env.*.qabak
*.qabak
e2e/.auth/
mcp_config.json

# Local scratch scripts and one-off migration/debug runners — never
# meant to be shared; ad-hoc and often hold live credentials inline.
scratch_*.cjs
scratch_*.js
run_migration.cjs

# node_modules committed inside docs/ (e.g. a pitch-deck build tool)
docs/**/node_modules

# ESLint cache dumps left behind by ad-hoc `--output-file` runs
cur.json
cur2.json
