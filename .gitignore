*.sln
*.sw?
.env
.env.local
.env.test
.env.*.qabak
*.qabak
e2e/.auth/
mcp_config.json

# Local scratch scripts and one-off migration/debug runners — never
# meant to be shared; ad-hoc and often hold live credentials inline.
scratch_*.cjs
scratch_*.js
run_migration.cjs

# node_modules committed inside docs/ (e.g. a pitch-deck build tool)
docs/**/node_modules

# ESLint cache dumps left behind by ad-hoc `--output-file` runs
cur.json
cur2.json

# Supabase CLI local link cache — regenerated by `npm run supabase:link` / `supabase link`.
# Was tracked until 2026-09-05: it discloses the project ref, org id, exact pooler hostname,
# DB username, and precise component versions (a CVE-matching shortcut). No password or key
# lives here, but the same project ref/org id are still in supabase/MIGRATION_RUNBOOK.md and
# two docs/db-audit files — untracking this alone does not fully close that disclosure; see
# the cleanup plan's Phase 3.5.
supabase/.temp/

# Local-only Edge Function secrets for `supabase functions serve` (Phase 6 edge-function
# testing). PHI_MASTER_KEY here is a throwaway key for the local Docker container only —
# never a real key, never committed.
supabase/functions/.env
