{
  "expo": {
    "name": "Aumrti HMS",
    "slug": "aumrti-hms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2F5A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aumrti.hms",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID for secure login",
        "NSCameraUsageDescription": "Scan documents and patient IDs"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2F5A"
      },
      "package": "com.aumrti.hms",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Aumrti HMS to use Face ID"
        }
      ]
    ],
    "scheme": "aumrti",
    "experiments": {
      "typedRoutes": true
    }
  }
}
